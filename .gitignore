# Python
__pycache__/
*.py[cod]
*$py.class
*.env
venv/
.venv/

# Temporary Office Lock files
~$*.docx
~$*.xlsx
~$*.pptx

# OS generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
